<form class="sn-sheet-body sn-compact" autocomplete="off">
  <header class="sn-header sn-header-compact">
    <div class="sn-portrait"><img src="{{actor.img}}" alt="" data-action="editImage" data-edit="img"></div>
    <div class="sn-ident">
      <input class="sn-name" type="text" name="name" value="{{actor.name}}">
      <div class="sn-row">
        <label>{{localize 'SOMBRANEON.Sheet.Level'}}<input type="number" name="system.level" value="{{system.level}}" min="1" max="5"></label>
        <label>HP<input type="number" name="system.hp.value" value="{{system.hp.value}}"> / <input type="number" name="system.hp.max" value="{{system.hp.max}}"></label>
        <label>{{localize 'SOMBRANEON.Sheet.AC'}}<input type="number" name="system.ac" value="{{system.ac}}"></label>
      </div>
    </div>
  </header>
  <section class="sn-scroll">
    <div class="sn-panel">
      <h3>{{localize 'SOMBRANEON.Ice.Attack'}}</h3>
      <p><strong>{{attackText}}</strong></p>
      <div class="sn-row">
        <label>{{localize 'SOMBRANEON.Sheet.Name'}}<input type="text" name="system.attack.name" value="{{system.attack.name}}"></label>
        <label>{{localize 'SOMBRANEON.Bonus'}}<input type="number" name="system.attack.bonus" value="{{system.attack.bonus}}"></label>
        <label>{{localize 'SOMBRANEON.Rolls.Damage'}}<input type="text" name="system.attack.damage" value="{{system.attack.damage}}"></label>
        <label>#<input type="number" name="system.attack.count" value="{{system.attack.count}}" min="1"></label>
      </div>
      <button type="button" class="sn-btn sn-primary" data-action="attackIce">{{localize 'SOMBRANEON.Attack.Roll'}}</button>
    </div>
    <div class="sn-panel sn-trick">
      <h3>{{localize 'SOMBRANEON.Ice.Trick'}}: {{system.trick.name}}</h3>
      <div class="sn-desc">{{{trick}}}</div>
      {{#if isAlarm}}<button type="button" class="sn-chip-btn" data-action="alarm">{{localize 'SOMBRANEON.Alert.Plus'}}</button>{{/if}}
      <label>{{localize 'SOMBRANEON.Ice.TrickName'}}<input type="text" name="system.trick.name" value="{{system.trick.name}}"></label>
      <textarea name="system.trick.text" rows="3">{{system.trick.text}}</textarea>
    </div>
    <div class="sn-panel"><label>{{localize 'SOMBRANEON.Ice.Role'}}<input type="text" name="system.networkRole" value="{{system.networkRole}}"></label></div>
  </section>
</form>
