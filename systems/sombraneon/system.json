    { "name": "origens", "label": "Origens", "path": "packs/origens", "type": "Item", "system": "sombraneon", "ownership": { "PLAYER": "OBSERVER", "ASSISTANT": "OWNER" } },
    { "name": "antecedentes", "label": "Antecedentes", "path": "packs/antecedentes", "type": "Item", "system": "sombraneon", "ownership": { "PLAYER": "OBSERVER", "ASSISTANT": "OWNER" } },
    { "name": "alinhamentos", "label": "Alinhamentos", "path": "packs/alinhamentos", "type": "Item", "system": "sombraneon", "ownership": { "PLAYER": "OBSERVER", "ASSISTANT": "OWNER" } },
    { "name": "caracteristicas", "label": "Características e Talentos", "path": "packs/caracteristicas", "type": "Item", "system": "sombraneon", "ownership": { "PLAYER": "OBSERVER", "ASSISTANT": "OWNER" } },
    { "name": "programas", "label": "Programas, Protocolos e Sets", "path": "packs/programas", "type": "Item", "system": "sombraneon", "ownership": { "PLAYER": "OBSERVER", "ASSISTANT": "OWNER" } },
    { "name": "tabelas", "label": "Tabelas", "path": "packs/tabelas", "type": "RollTable", "system": "sombraneon", "ownership": { "PLAYER": "OBSERVER", "ASSISTANT": "OWNER" } },
    { "name": "regras", "label": "Livro de Regras", "path": "packs/regras", "type": "JournalEntry", "system": "sombraneon", "ownership": { "PLAYER": "OBSERVER", "ASSISTANT": "OWNER" } }
